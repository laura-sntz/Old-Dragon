<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissões para usar Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Necessária para usar o tipo specialUse em Android 14+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".controller.BatalhaActivity"
            android:exported="false"
            android:label="@string/title_activity_batalha"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".controller.PersonagensDebugActivity"
            android:exported="true" />

        <activity
            android:name=".controller.MainActivity6"
            android:exported="false" />

        <activity
            android:name=".controller.MainActivity5"
            android:exported="false" />

        <activity
            android:name=".controller.MainActivity4"
            android:exported="false" />

        <activity
            android:name=".controller.MainActivity3"
            android:exported="false" />

        <activity
            android:name=".controller.MainActivity2"
            android:exported="false" />

        <activity
            android:name=".controller.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Service de simulação de batalha em foreground -->
        <service
            android:name=".controller.BatalhaForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />
        <!-- FIM DO SERVICE -->

    </application>

</manifest>
